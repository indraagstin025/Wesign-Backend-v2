# ═══════════════════════════════════════════════════════════
# WeSign Backend — Environment Configuration
# Copy file ini menjadi .env lalu sesuaikan nilainya.
# ═══════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────
APP_NAME=wesign
APP_ENV=development            # development | staging | production
APP_PORT=8080
APP_BASE_URL=http://localhost:8080/api/v1   # basis endpoint API (TDD §5.1)
APP_LOG_LEVEL=debug            # debug | info | warn | error

# ── PostgreSQL ───────────────────────────────────────────────
DATABASE_URL=postgres://wesign:wesign_secret@localhost:5432/wesign?sslmode=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=5m

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h           # 7 hari
JWT_ISSUER=wesign.id           # TDD §8.1
JWT_AUDIENCE=wesign-api        # TDD §8.1

# ── SMTP ─────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@wesign.local
SMTP_FROM_NAME=WeSign

# ── S3 / Object Storage ──────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=wesign-documents
S3_REGION=ap-southeast-1
S3_USE_SSL=false

# ── KMS ──────────────────────────────────────────────────────
KMS_PROVIDER=local             # local | aws
KMS_LOCAL_KEY_PATH=./tmp/kms/dev-root.key
AWS_KMS_KEY_ID=
AWS_REGION=ap-southeast-1

# ── Certificate Authority ────────────────────────────────────
CA_CERT_PATH=./tmp/ca/ca.crt
CA_KEY_PATH=./tmp/ca/ca.key

# ── River (Job Queue) ────────────────────────────────────────
RIVER_POLL_INTERVAL=1s
RIVER_MAX_WORKERS=10

# ── ClamAV ───────────────────────────────────────────────────
CLAMAV_URL=tcp://localhost:3310
CLAMAV_ENABLED=false

# ── Cloudflare Turnstile ─────────────────────────────────────
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_ENABLED=true        # Fail-Safe Default (TDD §1.5): aktif secara default
RATE_LIMIT_LOGIN=5             # max attempts
RATE_LIMIT_LOGIN_WINDOW=15m
RATE_LIMIT_API=120
RATE_LIMIT_API_WINDOW=1m

# ── OpenTelemetry (opsional) ─────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=   # kosong = exporter nonaktif (TDD §2.9)